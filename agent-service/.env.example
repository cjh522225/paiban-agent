# Agent 服务环境变量示例
# 复制为本地环境文件使用（Windows PowerShell：复制为 env.local.ps1 后 dot-source），不要提交真实密钥

# ===== 模型（必填）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== RAG 向量与重排（可选；缺省用本地哈希向量兜底）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
RAG_RERANK_ENABLED=false

# ===== 运行模式与端口 =====
# demo | paiban | dorm | dorm-demo
AGENT_MODE=paiban
AGENT_PORT=8090

# ===== 业务系统（按模式选择）=====
PAIBAN_BASE_URL=http://localhost:8080
PAIBAN_SERVICE_USERNAME=admin
PAIBAN_SERVICE_PASSWORD=

DORM_BASE_URL=http://localhost:8081
DORM_SERVICE_USERNAME=admin
DORM_SERVICE_PASSWORD=

# ===== 历史会话存储目录 =====
AGENT_CHAT_DIR=data/chat
